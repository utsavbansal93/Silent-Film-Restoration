.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.DS_Store
*.egg-info/
build/
dist/

# Run outputs and frame data — regenerable, too large for git
runs/
!runs/.gitkeep

# Test fixtures — regenerable via scripts/regenerate_fixture.sh
tests/fixtures/*.webm
tests/fixtures/*.mp4
!tests/fixtures/.gitkeep

# Large model weights — downloaded on demand
models/*.pb
models/*.pth
models/*.onnx
!models/.gitkeep

# Source file — 202 MB, downloaded separately
source/
*.webm

# IDE
.vscode/
.idea/

# Env
.env
